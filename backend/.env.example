# This file documents every environment variable the backend reads.
# Copy it to `.env` and fill in real values — `.env` is gitignored and must
# NEVER be committed. Nothing in this file is a real credential.

# "development" enables verbose request logging (morgan) and relaxes cookie
# flags for plain-HTTP local testing. Set to "production" only when this
# server is actually served over HTTPS — see cookieOptions() in
# authController.js, which derives Secure/SameSite from the request itself
# (via `trust proxy`), not from this flag alone, so a mismatch here can't
# silently break cookie auth either way.
NODE_ENV=development
PORT=5000

# MongoDB connection string (Atlas SRV URI or a local mongodb://). There is
# deliberately no fallback if this is unset — see config/db.js.
MONGO_URI=mongodb://localhost:27017/cowriteai

# ── Auth ─────────────────────────────────────────────────────────────────
# Long, random, unique per environment. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# There is no fallback if this is unset — see utils/token.js. Rotating this
# invalidates every existing session cookie.
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=7d

# Origin of the deployed frontend — used for CORS (app.js), for the JWT
# cookie's Secure/SameSite behavior, and for building links that point back
# at the app (share links, email verification links). Must be an exact
# origin: scheme + host, no trailing slash.
#
#   Production:  CLIENT_URL=https://cowriteai.netlify.app
#   Local dev:    CLIENT_URL=http://localhost:5173
#
# Set this to the production value below when deploying the backend; keep it
# as localhost in your local .env so local development is unaffected.
CLIENT_URL=https://cowriteai.netlify.app

# ── Outbound email (account verification) ───────────────────────────────
# Any standard SMTP account works (e.g. a transactional-email provider's SMTP
# endpoint, or a personal account for testing). If SMTP_HOST/USER/PASS are
# left blank, verification emails are NOT sent — the link is instead logged
# to the server console so the flow is still testable locally without a
# real mailbox. See utils/mailer.js.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="CoWriteAI <no-reply@cowriteai.local>"

# ── AI providers — at least one is recommended; the app falls back to
# local regex-based corrections if neither key is set. ──────────────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

OPENROUTER_API_KEY=
AI_MODEL=openai/gpt-4o-mini

# "auto" cascades OpenRouter -> Gemini -> local fallback. Set to "openrouter" or "gemini" to pin one.
AI_PROVIDER=auto
AI_TEMPERATURE=0.2
