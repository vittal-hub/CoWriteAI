# Copy to `.env` for local overrides if needed — `.env` is gitignored.
# Vite only exposes vars prefixed VITE_ to client code (see utils/api.js).
#
# Both are OPTIONAL. Leave them unset for local development — the Vite dev
# server proxies /api and /ws to the local backend (see vite.config.js), so
# relative paths already resolve correctly with nothing configured here.
#
# Set them when the frontend and backend are deployed as separate services
# (e.g. this frontend on Netlify at https://cowriteai.netlify.app, with the
# backend on Render/Railway/etc. at its own domain) — otherwise API/WebSocket
# requests would resolve against the Netlify domain itself, which serves no
# backend.
#
# Example production values (replace with your actual backend host):
#   VITE_API_URL=https://api.cowriteai.example.com
#   VITE_WS_URL=wss://api.cowriteai.example.com
VITE_API_URL=
VITE_WS_URL=
